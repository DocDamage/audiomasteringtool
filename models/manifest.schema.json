{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudioMasteringTool model manifest",
  "type": "object",
  "required": ["id", "version", "source", "artifact", "sha256", "runtime", "codeLicense", "weightsLicense", "commercialUse", "attribution", "ramMb", "vramMb", "securityReview"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "runtime": {"type": "string", "minLength": 1},
    "codeLicense": {"type": "string", "minLength": 1},
    "weightsLicense": {"type": "string", "minLength": 1},
    "commercialUse": {"type": "boolean"},
    "attribution": {"type": "string"},
    "ramMb": {"type": "integer", "minimum": 0},
    "vramMb": {"type": "integer", "minimum": 0},
    "securityReview": {"type": "string", "enum": ["pending", "approved", "rejected"]}
  }
}
