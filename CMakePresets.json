{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "AMT_BUILD_TESTS": "ON",
        "AMT_BUILD_BENCHMARKS": "ON",
        "AMT_WITH_ONNX": "OFF"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AMT_BUILD_TESTS": "ON",
        "AMT_BUILD_BENCHMARKS": "ON",
        "AMT_WITH_ONNX": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug"},
    {"name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release"},
    {"name": "ninja-debug", "configurePreset": "ninja-debug"}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "ninja-debug", "configurePreset": "ninja-debug", "output": {"outputOnFailure": true}}
  ]
}
